# Demo build defaults, committed on purpose.
#
# Loaded only by `vite build --mode demo` (`npm run build:demo`), which is the
# artefact deployed to preview hosting while the backend is unbuilt. `--mode demo`
# is also what sets `env.demoMode`, so this file cannot on its own turn a real
# build into a demo — see src/config/env.ts.
#
# What this produces: a real production React build that answers every request
# from the in-browser mock, with the permanent "Mock data" banner and the printed
# sign-in credentials both on. Nothing here is secret and nothing here reaches a
# network.

VITE_USE_MOCK=1

# Preview hosts (`*.vercel.app`) carry no tenant — their leading label is a
# deployment name, not a factory (packages/brand → PLATFORM_DOMAINS). So the demo
# tenant comes from this fallback rather than from the subdomain.
VITE_DEFAULT_TENANT=galaboda

# Unused while the mock is on: no request leaves the page. Kept as the placeholder
# so a demo build that somehow lost its mock fails loudly instead of quietly
# talking to a domain nobody owns.
VITE_API_BASE_URL=https://api.teafactory.example/v1

VITE_SEND_TENANT_HEADER=1
VITE_API_TIMEOUT_MS=20000
