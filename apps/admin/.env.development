# Development defaults, committed on purpose.
#
# Vite loads this automatically for `npm run dev`, so a fresh clone runs against the
# **local API** with a real tenant resolved and no setup.
#
# The backend serves on :3000 behind a `/v1` prefix (`configure-app.ts`) and allows this
# origin by default (`CORS_ORIGINS=http://localhost:5273` in its `.env.example`), so the
# two halves meet with nothing to configure. Start it with `npm run dev` in
# `tea-factory-digital-backend`.
#
# Nothing secret belongs here, and nothing here applies to a production build.
# Override any of it in `.env.local` (git-ignored).

VITE_API_BASE_URL=http://localhost:3000/v1
VITE_DEFAULT_TENANT=galaboda
VITE_SEND_TENANT_HEADER=1
VITE_API_TIMEOUT_MS=20000

# The API runs `COOKIE_MODE=same-site` locally, so it issues no CSRF cookie and the
# console must not send an empty header. Set both when the deployment is cross-site.
VITE_CSRF_COOKIE=
