# Development defaults, committed on purpose.
#
# Vite loads this automatically for `npm run dev`, so a fresh clone runs against
# the mock with a real tenant resolved and no setup. Without it the host carries
# no subdomain, the tenant resolves to `base`, and the console boots unbranded
# with a "could not reach the factory configuration" banner — which looks like a
# bug on day one.
#
# Nothing secret belongs here, and nothing here applies to a production build.
# Override any of it in `.env.local` (git-ignored).

VITE_USE_MOCK=1
VITE_DEFAULT_TENANT=galaboda
VITE_API_BASE_URL=https://api.teafactory.example/v1
VITE_SEND_TENANT_HEADER=1
VITE_API_TIMEOUT_MS=20000
