# Run the console against the deployed staging API.
#
#   npm run dev:staging      ->  http://localhost:5273
#
# Everything here is committed on purpose: it is a public URL and a tenant slug, and the
# point of the file is that testing against staging needs no setup.

# Direct, with no proxy in between. This was a relative `/v1` routed through a Vite dev
# proxy for as long as the staging box had CORS_ORIGINS unset, which made every browser
# request fail before it was sent. CORS now allows http://localhost:5273 and :5173, so
# the console calls the API the way a deployed console would, which is also the only way
# that exercises the real preflight and the real cross-site cookie.
VITE_API_BASE_URL=https://tfd-api-fja1.onrender.com/v1

VITE_DEFAULT_TENANT=galaboda
VITE_SEND_TENANT_HEADER=1

# ── Timeout ───────────────────────────────────────────────────────────────────────────
#
# 45s here against 20s locally, and only here. Staging is a FREE Render instance: it
# sleeps when idle, and the first request after that wakes it. Measured cold start was
# about 33s, so the normal 20s guarantees a failure on the first page load every time.
#
# This is not a judgement that 20s is wrong. It is right for a rural connection, and
# raising it in production would make every genuine failure take 45 seconds to report.
# It is raised for this file alone, because this one deployment has a known cold start.
# Agreed as acceptable pre-users; it goes away on a paid instance or with a keep-alive.
VITE_API_TIMEOUT_MS=45000

# ── CSRF ──────────────────────────────────────────────────────────────────────────────
#
# Staging runs COOKIE_MODE=cross-site, so it DOES issue a tfd_csrf cookie and the console
# must echo it back on refresh. Locally the API is same-site, issues no such cookie, and
# .env.development leaves this empty so the console does not send an empty header.
VITE_CSRF_COOKIE=tfd_csrf
