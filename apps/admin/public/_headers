# Cloudflare Pages — the same headers vercel.json sets, in Pages' format.
#
# Rules apply in order and accumulate; a later rule wins for a header it repeats.
# Read from the build output, so this lives in `public/` (see _redirects).

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed filenames, so a release cannot collide with a cached copy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The one file that must never be cached: it names the hashed assets, so a stale
# copy pins a returning clerk to the previous release indefinitely.
/index.html
  Cache-Control: no-cache, must-revalidate

# Same reasoning, plus a cached worker would serve the previous mock contract.
/mockServiceWorker.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
