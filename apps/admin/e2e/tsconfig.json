{
  // Playwright loads the nearest tsconfig at runtime and cannot follow the app
  // config's project `references` (it resolves them as files, not directories).
  // This standalone config is what it reads; `apps/admin/tsconfig.json` still
  // type-checks these specs as part of `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    // The fixture loads the mock handlers, which import the app's own modules.
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@tfd/domain": ["../../packages/domain/src/index.ts"],
      "@tfd/brand": ["../../packages/brand/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
