{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    // Do not reintroduce `ignoreDeprecations` here. It carried "6.0", which the
    // installed TypeScript (5.9) rejects as an invalid value — and it rejects it
    // *before* checking any file, so `npm run typecheck` exited 2 on the config
    // and checked nothing at all. Two screens shipped a missing import and went
    // blank in front of the office while the command "failed" for what looked
    // like a config nit. Nothing in this project needs the flag.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tfd/domain": ["../../packages/domain/src/index.ts"],
      "@tfd/brand": ["../../packages/brand/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  // Referenced by explicit file path, not by directory: Playwright's tsconfig
  // loader resolves `references` as files and fails on a directory.
  "references": [
    { "path": "../../packages/domain/tsconfig.json" },
    { "path": "../../packages/brand/tsconfig.json" }
  ]
}
